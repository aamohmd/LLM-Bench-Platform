# Local development only. Set a password in both values before starting.
POSTGRES_DB=benchmark
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://benchmark:change-me@postgres:5432/benchmark
ALLOWED_ORIGINS=http://localhost:3000
# Local HTTP only. Set true for an HTTPS deployment.
SESSION_COOKIE_SECURE=false
